# Copy to .env.e2e (gitignored) and fill in. Never commit real creds.
E2E_BASE_URL=http://localhost:3000
# The company slug in the URL: http://localhost:3000/<slug>/login
E2E_SLUG=change-me

# ── Hermetic reset + seed (reset.setup.ts, runs before every auth setup) ──────
# `pnpm e2e:journey` (and `pnpm e2e`) first POST to the GUARDED backend reset endpoints
# to truncate the transactional request tables and seed the journey fixtures. For this to
# work the BACKEND must run with the reset endpoint ENABLED:
#   set `e2e.reset.enabled: true` in wos-hr AND wos-notification — already set in their
#   application-dev.yaml (the default `dev` profile). It defaults to false / 404s otherwise.
# Shared internal token — must match the backend `internal.service-token`
# (defaults to the dev token, so local runs work with no extra config).
E2E_RESET_TOKEN=wos-internal-dev-token
# Backend base URLs the reset step calls directly (must match app/api/[...path]/route.ts).
HR_API_URL=http://localhost:8083
NOTIFICATION_API_URL=http://localhost:8086
# The company (tenant) id the fixtures belong to. Defaults to 1 (the seeded "GPR" company).
# E2E_COMPANY_ID=1
# VACATION days to grant the test employee if they lack a credit-bearing contract. Default 15.
# E2E_VACATION_CREDITS=15

# Admin — email/password, fully automated (pnpm e2e:auth)
E2E_ADMIN_EMAIL=admin@yourcompany.com
E2E_ADMIN_PASSWORD=change-me

# Employee — email/password, fully automated (pnpm e2e:auth:employee).
# Use a PASSWORD-based test employee (NOT a Google-OAuth account) with OB filing permission.
E2E_EMPLOYEE_EMAIL=employee@yourcompany.com
E2E_EMPLOYEE_PASSWORD=change-me

# Second admin — ONLY the co-approver journeys use this (ob-co-approver-notified.spec.ts
# and leave-co-approver-notified.spec.ts). Must be a DIFFERENT company admin than E2E_ADMIN,
# in the SAME company, so the co-approver "… handled" notification is raised for them.
# Leave unset to skip those journeys. (pnpm e2e:auth:admin2)
E2E_ADMIN2_EMAIL=admin2@yourcompany.com
E2E_ADMIN2_PASSWORD=change-me

# Optional: pin the day the leave co-approver journey files (YYYY-MM-DD). Defaults to
# ~2 weeks out and steps forward past rest days / holidays. The filing employee must have
# leave credits for the default VACATION type.
# E2E_LEAVE_DATE=2026-08-17
